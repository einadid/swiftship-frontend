# SwiftShip Frontend Environment Variables

# Backend API URL - for production deployment
# For local dev, leave empty to use proxy (/api -> http://127.0.0.1:8000)
# VITE_API_URL=https://your-backend.onrender.com/api

# Proxy target for local dev (optional)
# VITE_PROXY_TARGET=http://127.0.0.1:8000
